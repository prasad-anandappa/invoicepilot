# PayPal — leave blank to run in deterministic MOCK mode (no real money).
# Fill these with Sandbox app credentials from developer.paypal.com to
# switch to the real PayPal Sandbox API — no code changes needed.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Optional: set to your PayPal webhook ID to require signature
# verification on POST /api/paypal/webhook deliveries.
PAYPAL_WEBHOOK_ID=

# Optional LLM parsing — leave blank to use the built-in rule-based parser.
INVOICEPILOT_LLM_API_KEY=
INVOICEPILOT_LLM_BASE_URL=https://api.openai.com/v1
INVOICEPILOT_LLM_MODEL=gpt-4o-mini
